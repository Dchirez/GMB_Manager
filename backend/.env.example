# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=https://gmb-backend.dchirez.fr/auth/callback

# Flask Configuration
FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET

# Database Configuration
# Production: Supabase EU (Frankfurt) — connection pooler, mode Transaction (port 6543)
# Format: postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/gmb_manager

# Frontend URL
FRONTEND_URL=https://gmb.dchirez.fr

# Supabase Configuration (for photo storage)
# RGPD: create the Supabase project in region Central EU (Frankfurt / eu-central-1)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# Optional: dedicated encryption key for OAuth tokens at rest.
# If unset, derived from SECRET_KEY. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=

# Database Reset (set to 'true' to drop and recreate all tables on startup)
RESET_DB=false
